ders\",\"name\":\"Regrowth Striders\",\"imagePath\":\"Items/T3/Icon_T3_RegrowthStriders.png\",\"tier\":3,\"itemType\":\"Item\",\"stats\":{\"CooldownReductionPercent\":10,\"ManaPerTime\":3,\"PhysicalProtection\":35},\"passive\":\"Heal yourself with an Ability:\\n• +25% Movement Speed (decays to 0%) for 4s\\n• Cooldown: 10s\\n\\nGain any Movement Speed buff:\\n• +5% Health Heal over 10s\",\"passiveTokens\":null,\"active\":null,\"activeTokens\":null,\"description\":\"Heal yourself with an Ability:\\n• +25% Movement Speed (decays to 0%) for 4s\\n• Cooldown: 10s\\n\\nGain any Movement Speed buff:\\n• +5% Health Heal over 10s\",\"descriptionTokens\":null,\"totalGoldCost\":2550,\"isLegacy\":false},\"4fae1f9e-7b53-45cd-ae52-1a9c7792dd75\":{\"slug\":\"shield\",\"name\":\"Shield\",\"imagePath\":\"Items/T1/Icon_T1_Shield.png\",\"tier\":1,\"itemType\":\"Item\",\"stats\":{\"PhysicalProtection\":6},\"passive\":null,\"passiveTokens\":null,\"active\":null,\"activeTokens\":null,\"description\":\"\",\"descriptionTokens\":null,\"totalGoldCost\":300,\"isLegacy\":false},\"ef86b4f6-959b-4a92-86cc-7704d59e530b\":{\"slug\":\"the-crusher\",\"name\":\"The Crusher\",\"imagePath\":\"Items/T3/Icon_T3_Crusher.png\",\"tier\":3,\"itemType\":\"Item\",\"stats\":{\"MagicalPenetrationFlat\":10,\"PhysicalPenetrationFlat\":10,\"PhysicalPower\":55},\"passive\":\"Ability Hit: +Physical Damage.\\n• Damage = 35% of your Strength\\n• Damage is dealt over 1s\\n• Subsequent hits on the same target deal 33% bonus Damage, over 3s.\",\"passiveTokens\":null,\"active\":null,\"activeTokens\":null,\"description\":\"Ability Hit: +Physical Damage.\\n• Damage = 35% of your Strength\\n• Damage is dealt over 1s\\n• Subsequent hits on the same target deal 33% bonus Damage, over 3s.\",\"descriptionTokens\":null,\"totalGoldCost\":2750,\"isLegacy\":false},\"1e12ec1b-78d1-4687-b5ab-62f689a6aa5c\":{\"slug\":\"caestus\",\"name\":\"Caestus\",\"imagePath\":\"Items/T2/Icon_T2_Caestus.png\",\"tier\":2,\"itemType\":\"Item\",\"stats\"